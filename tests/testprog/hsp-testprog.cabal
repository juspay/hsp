cabal-version:      3.0
name:               hsp-testprog
version:            0.1.0
synopsis:           A GHC program with a known shape, for hsp's live tests
build-type:         Simple

executable hsp-testprog
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base
  default-language: Haskell2010
  -- The flags a program needs for hsp to name everything it samples:
  -- IPE tables (with stack frames), a symbol for every local function
  -- (otherwise non-exported code is named by the nearest preceding symbol),
  -- and DWARF line information.  None of them changes the generated code.
  ghc-options:      -O2 -threaded -rtsopts
                    -finfo-table-map -finfo-table-map-with-stack
                    -fexpose-internal-symbols -g1
